{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "stock-MING Command Center",
  "version": "3.0.0",
  "identifier": "com.stockming.commandcenter",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "COMMAND_CENTER_3_LAUNCHER_SKIP_OPEN=1 ../scripts/start_command_center_3.command",
    "beforeBuildCommand": "npm run build"
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "10.13",
      "hardenedRuntime": true
    }
  },
  "app": {
    "windows": [
      {
        "title": "stock-MING Command Center 3.0",
        "width": 1280,
        "height": 820,
        "resizable": true
      }
    ]
  }
}
